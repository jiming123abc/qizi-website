# 环境变量配置示例
# 复制此文件为 .env 并填入实际配置值

# ==============================================
# 服务器配置
# ==============================================
PORT=5000
NODE_ENV=development

# ==============================================
# 阿里云 OSS 配置（可选，不配置则使用本地存储）
# ==============================================
REACT_APP_OSS_ACCESS_KEY_ID=你的OSS AccessKey ID
REACT_APP_OSS_ACCESS_KEY_SECRET=你的OSS AccessKey Secret
REACT_APP_OSS_BUCKET=你的Bucket名称
REACT_APP_OSS_REGION=oss-cn-beijing
REACT_APP_OSS_ENDPOINT=

# ==============================================
# 微信分享配置（可选，需要微信公众号）
# ==============================================
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# ==============================================
# Gemini API 配置（可选）
# ==============================================
GEMINI_API_KEY=
