# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# 阿里云OSS配置
REACT_APP_OSS_ACCESS_KEY_ID="你的OSS AccessKey ID"
REACT_APP_OSS_ACCESS_KEY_SECRET="你的OSS AccessKey Secret"
REACT_APP_OSS_BUCKET="你的Bucket名称"
REACT_APP_OSS_REGION="oss-cn-beijing"
REACT_APP_OSS_ENDPOINT="https://你的Bucket名称.oss-cn-beijing.aliyuncs.com"

# 阿里云视频点播VOD配置
REACT_APP_VOD_ACCESS_KEY_ID="你的VOD AccessKey ID"
REACT_APP_VOD_ACCESS_KEY_SECRET="你的VOD AccessKey Secret"
REACT_APP_VOD_REGION="cn-beijing"

# 微信公众号配置
WECHAT_APP_ID="你的微信公众号AppID"
WECHAT_APP_SECRET="你的微信公众号AppSecret"
